# Production: PostgreSQL connection string (Runpod-approved provider).
# When unset, the app uses an embedded PGlite database at .data/pglite (local dev only).
DATABASE_URL=

# Auth provider: "dev" (local cookie-based identity) or "sso" (requires SSO integration, see docs/deployment-vercel.md)
AUTH_PROVIDER=dev

# Secret used to protect the outbox processing endpoint (cron worker). Required in production.
OUTBOX_PROCESS_TOKEN=

# Vercel injects this bearer secret into configured cron requests.
CRON_SECRET=

# Optional operator token for manually invoking the GTM source reconciliation
# worker. Vercel cron uses CRON_SECRET automatically.
SOURCE_SYNC_TOKEN=

# Notion internal integration token used only by configured GTM source
# connectors. Never store this value in the GTM catalog itself.
NOTION_API_TOKEN=

# Slack app (slash command, modals, shortcuts, CSV bulk upload)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_ENTERPRISE_IDS=
SLACK_ALLOWED_TEAM_IDS=
# Optional fallback when Slack profile emails cannot be read: {"U123":"person@runpod.io"}
SLACK_USER_EMAIL_MAP_JSON={}
# Canonical deployed URL used in Slack result links
APP_URL=http://localhost:3000

# HubSpot private-app token for campaign sync (optional; sync stays queued without it)
HUBSPOT_ACCESS_TOKEN=

# Comma-separated allowlist of production Chrome extension IDs. Required in
# production before the extension PKCE flow and CORS access are enabled.
EXTENSION_IDS=
