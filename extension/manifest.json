{
  "manifest_version": 3,
  "name": "Runpod UTM Builder",
  "version": "1.0.0",
  "description": "Create governed Runpod campaign URLs from the page or link you are working with.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "contextMenus", "sidePanel", "storage", "identity"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "service-worker.js" },
  "storage": { "managed_schema": "managed-storage-schema.json" },
  "action": { "default_title": "Create governed UTM" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+U", "mac": "MacCtrl+Shift+U" },
      "description": "Open the Runpod UTM Builder"
    }
  }
}
