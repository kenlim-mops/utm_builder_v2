{
  "name": "utm-builder-registry",
  "version": "2.0.0",
  "private": true,
  "description": "Runpod UTM Builder & Registry — governed campaign links, one authoritative registry",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
